        "# ============================================================================\n",
        "# MULTI-TURN ATTACK CHAIN BUILDER\n",
        "# ============================================================================\n",
        "\n",
        "class ChainBuilder:\n",
        "    \"\"\"Build multi-turn adversarial attack chains.\"\"\"\n",
        "\n",
        "    def __init__(self):\n",
        "        self.chain_strategies = {\n",
        "            'social_engineering': self._build_social_engineering_chain,\n",
