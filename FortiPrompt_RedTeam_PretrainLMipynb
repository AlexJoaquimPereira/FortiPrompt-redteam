      "source": [
        "# ============================================================================\n",
        "# ENHANCED MODEL SELECTION: ZEPHYR-7B QLoRA\n",
        "# ============================================================================\n",
        "\n",
        "# Replacing DistilGPT2 with Zephyr-7B-beta (Mistral-based state-of-the-art 7B)\n",
        "MODEL_NAME = \"HuggingFaceH4/zephyr-7b-beta\"\n",
        "\n",
        "OUTPUT_DIR = \"./adversarial_zephyr_mutator\"\n",
        "MAX_LENGTH = 256  # Increased from 128 for better context\n",
        "BATCH_SIZE = 4    # Reduced for T4 compatibility\n",
        "NUM_EPOCHS = 3    # 7B models converge faster\n",
        "\n",
        "print(f\"Selected model: {MODEL_NAME}\")\n",
        "\n",
        "# Using bracket-style tokens to avoid embedding resizing issues in 4-bit\n",
        "PREFIX_MAP = {\n",
        "    'jailbreak': '[JAILBREAK]',\n",
        "    'prompt_injection': '[INJECT]',\n",
        "    'role_play': '[ROLEPLAY]',\n",
        "    'social_engineering': '[SOCIAL]',\n",
        "    'hypothetical': '[HYPO]',\n",
        "    'obfuscation': '[OBFUSCATE]',\n",
        "    'multi_turn': '[CHAIN]',\n",
        "    'general': '[ADVERSARIAL]'\n",
        "}\n",
        "\n",
        "# Wrap in training format\n",
        "df['training_text'] = df.apply(\n",
        "    lambda row: f\"{PREFIX_MAP[row['category']]} {row['prompt']}\",\n",
        "    axis=1\n",
        ")\n",
        "\n",
        "print(f\"✅ Prepared {len(df)} training examples\")"
      ]
    },
