      "source": [
        "# ============================================================================\n",
        "# CELL 9: OPTIMIZED TRAINING (Dynamic Padding + Step Limits)\n",
        "# ============================================================================\n",
        "\n",
        "train_dataset = Dataset.from_pandas(df[['training_text']])\n",
        "\n",
        "def tokenize_function(examples):\n",
        "    # CRITICAL CHANGE: padding=False\n",
        "    # We let the DataCollator handle padding dynamically per batch.\n",
        "    # This creates variable length batches, which is MUCH faster.\n",
        "    return tokenizer(\n",
        "        examples['training_text'],\n",
        "        truncation=True,\n",
        "        max_length=MAX_LENGTH,\n",
        "        padding=False\n",
        "    )\n",
        "\n",
        "tokenized_dataset = train_dataset.map(\n",
        "    tokenize_function,\n",
        "    batched=True,\n",
        "    remove_columns=['training_text']\n",
        ")\n",
        "\n",
        "# Sort dataset by length for even faster training (groups similar lengths)\n",
        "# This minimizes padding within each batch\n",
        "tokenized_dataset = tokenized_dataset.sort(\"length\") if \"length\" in tokenized_dataset.column_names else tokenized_dataset\n",
        "\n",
        "# T4 Optimized & Time-Capped Training Arguments\n",
        "training_args = TrainingArguments(\n",
        "    output_dir=OUTPUT_DIR,\n",
        "\n",
        "    # Batch Size Config\n",
        "    per_device_train_batch_size=4,   # Keep small for T4\n",
        "    gradient_accumulation_steps=4,   # Effective batch size = 16\n",
        "\n",
        "    # Time Management (The Fix)\n",
        "    max_steps=100,                   # Hard limit: Train for exactly 100 steps\n",
        "    warmup_steps=10,                 # Warmup for 10% of steps\n",
        "\n",
        "    # Optimization\n",
        "    learning_rate=2e-4,              # Standard QLoRA rate\n",
        "    fp16=True,                       # Fast precision\n",
        "    optim=\"paged_adamw_32bit\",       # Memory efficient optimizer\n",
        "    logging_steps=10,\n",
        "    save_strategy=\"no\",              # Don't save checkpoints to save disk space/time\n",
        "    report_to=\"none\",\n",
        "\n",
        "    # Dynamic Padding Helper\n",
        "    group_by_length=True,            # Groups similar length sentences together\n",
        ")\n",
        "\n",
        "# DataCollator will now handle the padding dynamically\n",
        "data_collator = DataCollatorForLanguageModeling(\n",
        "    tokenizer=tokenizer,\n",
        "    mlm=False,\n",
        "    pad_to_multiple_of=8 # Optimization for tensor cores\n",
        ")\n",
        "\n",
        "trainer = Trainer(\n",
        "    model=model,\n",
        "    args=training_args,\n",
        "    train_dataset=tokenized_dataset,\n",
        "    data_collator=data_collator,\n",
        ")\n",
        "\n",
        "print(f\"🚀 Starting Optimized Zephyr QLoRA training (Max Steps: 100)...\")\n",
        "start_time = time.time()\n",
        "trainer.train()\n",
        "end_time = time.time()\n",
        "\n",
        "print(f\"⏱️ Training finished in {(end_time - start_time)/60:.1f} minutes\")\n",
        "\n",
        "# Save adapter\n",
        "trainer.model.save_pretrained(OUTPUT_DIR)\n",
        "print(f\"✅ Adapter saved to {OUTPUT_DIR}\")"
      ]
    },
